GROQ_API_KEY=replace_with_your_new_key
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql+asyncpg://supportflow:supportflow@127.0.0.1:5433/supportflow
CHECKPOINT_DATABASE_URL=postgresql://supportflow:supportflow@127.0.0.1:5433/supportflow
CHROMA_PATH=.local/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
API_KEY=local-dev-api-key-change-me
REVIEWER_API_KEYS={"reviewer-demo":"replace-with-a-separate-reviewer-secret"}
AUTH_MODE=local
# Main workflow: database-backed registration and login.
# Optional LOCAL_AUTH_SECRET (32+ characters); otherwise generated in .local/auth-signing.key
EMAIL_ENABLED=false
EMAIL_WORKER_IN_API=true
EMAIL_DELIVERY_MODE=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=supportflow@localhost
# For real SMTP: EMAIL_DELIVERY_MODE=smtp, SMTP_STARTTLS=true,
# SMTP_USERNAME=..., SMTP_PASSWORD=... (requires verified account email)
# Original header-based test mode: AUTH_MODE=demo
# Optional verified identities (Keycloak profile):
# AUTH_MODE=oidc
# OIDC_ISSUER=http://localhost:8080/realms/supportflow
# OIDC_AUDIENCE=supportflow-api
# OIDC_JWKS_URL=http://localhost:8080/realms/supportflow/protocol/openid-connect/certs
# OIDC_ALLOW_HTTP=true

# Optional voice channel. Install .[voice] and run python -m scripts.prepare_voice.
# Merge the generated .local/voice/settings.env values to enable English/Hindi.
VOICE_ENABLED=false
VOICE_ASR_MODEL=small
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8
VOICE_OFFLINE=true
VOICE_TTS_BACKEND=piper
VOICE_PIPER_MODELS={}
VOICE_MAX_CONNECTIONS=2
VOICE_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Broader Indic output requires the separate Indic-Parler installation and weights:
# VOICE_TTS_BACKEND=indic_parler
# VOICE_INDIC_MODEL=ai4bharat/indic-parler-tts
